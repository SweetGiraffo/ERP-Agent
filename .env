# LLM
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-4o-mini

# ERP login (erp.iitkgp.ac.in)
ERP_USERNAME=XXYYXXXXX
ERP_PASSWORD=your_erp_password

# ERP asks ONE of your 3 registered security questions at random on every
# login, so all 3 need to be here. Copy each question's wording EXACTLY as
# it appears on the ERP page (log in manually once to see them) - matching
# is an exact string match.
ERP_SECURITY_Q1=your first security question, exact wording
ERP_SECURITY_A1=answer to question 1
ERP_SECURITY_Q2=your second security question, exact wording
ERP_SECURITY_A2=answer to question 2
ERP_SECURITY_Q3=your third security question, exact wording
ERP_SECURITY_A3=answer to question 3

# Sender ERP's OTP emails come from - this default is correct for IIT KGP,
# only change it if your OTPs are landing from a different address.
ERP_OTP_SENDER=erpkgp@adm.iitkgp.ac.in

# The in-ERP URL of your placements/jobs listing page, opened right after
# login. There's no way to know this in advance - log in to ERP yourself,
# click through to wherever jobs are listed, and paste that URL here.
ERP_JOBS_URL=https://erp.iitkgp.ac.in/IIT_ERP3/...

# Gmail API (OAuth desktop client JSON from Google Cloud Console) - used to
# fetch the OTP email automatically. See:
# https://developers.google.com/gmail/api/quickstart/python
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# Twilio WhatsApp (leave blank to use email instead)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
NOTIFY_WHATSAPP_TO=whatsapp:+91XXXXXXXXXX

# SMTP fallback
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASSWORD=
NOTIFY_EMAIL_TO=you@example.com

# Behavior
RESUME_FILE=resume.txt
REQUIRE_APPROVAL=true
HEADLESS=false
erp_username=25ma60r29
erp_jobs_url=https://erp.iitkgp.ac.in/IIT_ERP3/...
llm_model=gpt-4o-mini
resume_file=resume.txt
erp_otp_sender=erpkgp@adm.iitkgp.ac.in
notify_email_to=you@example.com
notify_whatsapp_to=whatsapp:+91XXXXXXXXXX
smtp_host=smtp.gmail.com
smtp_port=465
gmail_credentials_file=credentials.json
gmail_token_file=token.json
twilio_account_sid=
require_approval=true
headless=false
